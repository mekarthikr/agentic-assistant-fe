VITE_WS_URL=wss://agentic-assistant-two.vercel.app/ws
VITE_API_URL=https://agentic-assistant-two.vercel.app
# Set this only when the backend SOCKET_AUTH_TOKEN is configured.
VITE_WS_AUTH_TOKEN=token
# RAG sources are hidden unless this is explicitly true.
VITE_SHOW_RAG_SOURCES=true
# Token usage is hidden unless this is explicitly true.
VITE_SHOW_TOKEN_USAGE=false
# Document upload, selection, and answer-mode controls are hidden by default.
VITE_ENABLE_DOCUMENTS=false
# The Agent/Client toggle selects the hardcoded application profile.
